{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ideation",
  "version": "0.1.0",
  "identifier": "dev.ideation.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ideation",
        "width": 1296,
        "height": 810,
        "visible": false,
        "center": true,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "Ideation contributors",
    "copyright": "MIT License, Ideation contributors",
    "category": "DeveloperTool",
    "shortDescription": "Whiteboard with Claude Code chat and pilots",
    "longDescription": "A whiteboard where each board is a git repo. Chat with Claude about the board, accept suggested edits, and launch Claude Code pilots that run in their own branches."
  }
}
